{
  "name": "cake-play",
  "version": "1.0.0",
  "description": "Cake Play — Suika-style waiting-room merge game for Cake Studio Guatemala",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c pink,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "PORT=3847 node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
